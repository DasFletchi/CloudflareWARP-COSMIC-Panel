[Unit]
Description=Cloudflare WARP COSMIC Panel Tray
Documentation=https://github.com/DasFletchi/CloudflareWARP-COSMIC-Panel
After=graphical-session.target network.target com.system76.CosmicStatusNotifierWatcher.service
Wants=com.system76.CosmicStatusNotifierWatcher.service

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for i in {1..30}; do busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 0'
ExecStart=%h/.local/bin/warp-cosmic tray
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
