[Unit]
Description=Cloudflare WARP COSMIC Panel Tray
Documentation=https://github.com/DasFletchi/CloudflareWARP-COSMIC-Panel
After=graphical-session.target network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/warp-cosmic tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
